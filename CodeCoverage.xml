<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>

    <!--
Settings for Microsoft.Testing.Extensions.CodeCoverage: dotnet test -solution Refrakt.slnx -coverage -coverage-settings CodeCoverage.xml
About include/exclude lists:
Empty "Include" clauses imply all; empty "Exclude" clauses imply none.
Each element in the list is a regular expression (ECMAScript syntax), matched against the full module path.
An item must first match at least one entry in the include list to be included.
Included items must then not match any entries in the exclude list to remain included.
The exclude entry matches the file name only: the full path always contains the "tests" folder.
-->

    <!-- Match assembly file paths: -->
    <ModulePaths>
      <Include>
        <ModulePath>.*Refrakt.*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*[\/][^\/]*Tests[^\/]*\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>

  </CodeCoverage>
</Configuration>

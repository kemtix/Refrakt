<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Xunit.StaFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Wpf\Refrakt.Wpf\Refrakt.Wpf.csproj" />
    <ProjectReference Include="..\Refrakt.IocContainer.Wpf.Tests.Support\Refrakt.IocContainer.Wpf.Tests.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Refrakt.Core.Tests\Mvvm\ViewModelLocationProviderReset.cs" Link="Mvvm\ViewModelLocationProviderReset.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Mocks\Modules\*.cs" />
    <Page Remove="Modularity\ModuleCatalogXaml\InvalidDependencyModuleCatalog.xaml" />
    <Resource Include="Modularity\ModuleCatalogXaml\InvalidDependencyModuleCatalog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Resource>
    <Resource Include="Modularity\ModuleCatalogXaml\SimpleModuleCatalog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Resource>
  </ItemGroup>

</Project>